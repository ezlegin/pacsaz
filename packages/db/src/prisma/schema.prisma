generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//! USERS --------------------------------
model Admin {
  id          Int    @id @default(autoincrement())
  fullName    String
  phoneNumber String @unique
  email       String @unique
  password    String
}

model User {
  id                  Int        @id @default(autoincrement())
  email               String     @unique
  phoneNumber         String     @unique
  firstName           String
  lastName            String?
  fullName            String
  usageGoal           UsageGoal?
  onboardingCompleted Boolean    @default(false)
  joinedAt            DateTime   @default(now())
  userType            UserType?

  downloads     DownloadHistory[]
  favedDielines FavedDieline[]
  savedDielines SavedDieline[]
  plans         Plan[]
  payments      Payment[]
  customers     Customer[]
  paymentTracks PaymentTrack[]
  notifications NotificationLog[]
}

enum UsageGoal {
  practice
  projects
  portfolio
  hobby
  other
}

enum UserType {
  student
  designer
  designStudio
  printHouse
  dielineMaker
  packagingFactory
  other
}

model Customer {
  id          Int      @id @default(autoincrement())
  fullName    String
  phoneNumber String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())

  savedDielie SavedDieline[]
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int?
}

model Otp {
  id          Int      @id @default(autoincrement())
  phoneNumber String
  code        String
  expiresAt   DateTime

  @@unique([code, phoneNumber])
}

//! CONTACT --------------------------------
/**
 * Messages from the public contact form. Deliberately not related to `User`:
 * anyone can write in, signed in or not, so an account is not required and a
 * submission must survive that account being deleted.
 */
model Contact {
  id          Int           @id @default(autoincrement())
  fullName    String
  email       String
  phoneNumber String?
  subject     String
  message     String
  status      ContactStatus @default(new)

  /**
   * Reply body, stored even when delivery fails so nothing is lost.
   */
  replyMessage String?
  repliedAt    DateTime?
  /**
   * Whether the reply actually left via the provider.
   */
  replySent    Boolean   @default(false)
  /**
   * Provider-side message id, for tracing a delivery.
   */
  replyId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum ContactStatus {
  new
  read
  replied
}

//! DIELINE --------------------------------
model Dieline {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  specification   String
  variable        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  active          Boolean  @default(true)
  materials       String
  defaultMaterial String
  dimensionTypes  String
  minWidth        Float
  minLength       Float
  minHeight       Float
  maxWidth        Float
  maxLength       Float
  maxHeight       Float

  categoryByUsage DielineCategoryByUsage[]
  categoryByModel DielineCategoryByModel[]
  downloadHistory DownloadHistory[]
  favedDieline    FavedDieline[]
  savedDielines   SavedDieline[]
  settings        DielineSettings          @relation(fields: [settingsId], references: [id])
  settingsId      Int                      @unique
  dielineImage    DielineImage?
  modelImage      ModelImage?
}

model DielineImage {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String   @unique
  createdAt DateTime @default(now())
  dieline   Dieline  @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId Int      @unique
}

model ModelImage {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String   @unique
  createdAt DateTime @default(now())
  dieline   Dieline  @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId Int      @unique
}

model DielineSettings {
  id            Int           @id @default(autoincrement())
  bleed         Int
  thickness     Float
  material      String
  width         Float
  length        Float
  height        Float
  dimensionType DimensionType
  /// Authored per-panel fold direction and angle, as JSON. Empty means the
  /// viewer falls back to its geometric inference. See @repo/dieline-3d.
  foldConfig    String        @default("")

  dieline Dieline?
}

model CustomDielineSettings {
  id            Int           @id @default(autoincrement())
  bleed         Int
  thickness     Float
  material      String
  width         Float
  length        Float
  height        Float
  dimensionType DimensionType

  savedDieline      SavedDieline?    @relation(fields: [savedDielineId], references: [id], onDelete: Cascade)
  savedDielineId    Int?             @unique
  downloadHistory   DownloadHistory? @relation(fields: [downloadHistoryId], references: [id], onDelete: SetNull)
  downloadHistoryId Int?             @unique
}

model DielineCategoryByUsage {
  id      Int       @id @default(autoincrement())
  title   String
  slug    String    @unique
  dieline Dieline[]
}

model DielineCategoryByModel {
  id      Int       @id @default(autoincrement())
  title   String
  slug    String    @unique
  dieline Dieline[]
}

model SavedDieline {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dieline    Dieline                @relation(fields: [dielineId], references: [id])
  dielineId  Int
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  customer   Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId Int?
  settings   CustomDielineSettings?
}

model DownloadHistory {
  id           Int      @id @default(autoincrement())
  downloadedAt DateTime @default(now())

  dieline   Dieline @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  plan      Plan    @relation(fields: [planId], references: [id])
  planId    Int

  settings CustomDielineSettings?
}

model FavedDieline {
  id Int @id @default(autoincrement())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  dieline   Dieline @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId Int

  @@unique([userId, dielineId])
}

enum Material {
  cFlute
  beFlute
  bcFlute
  abFlute
  artPaper
  glossyCardboard
  fFlute
  eFlute
  bFlute
}

enum DimensionType {
  manufacture
  inner
  outer
}

//! PAYMENT --------------------------------
model Payment {
  id                 Int           @id @default(autoincrement())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  amount             Float
  total              Float
  totalDiscount      Float
  discountCodeAmount Float
  discountCode       String?
  status             PaymentStatus
  method             PaymentMethod
  authority          String?       @unique
  period             PlanPeriod

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  tarrif   Tarrif  @relation(fields: [tarrifId], references: [id])
  tarrifId Int
  plan     Plan?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId Int?
}

model PaymentTrack {
  id     Int        @id @default(autoincrement())
  plan   PlanKey
  period PlanPeriod
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
}

model Coupon {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  expiresAt DateTime
  amount    Float
  used      Int        @default(0)
  limit     Int?
  createdAt DateTime   @default(now())
  type      CouponType
  /// Where the coupon came from. Orthogonal to `type`: `type` says how the
  /// discount is computed, `source` says who minted the coupon. Campaign
  /// coupons are created by the monthly marketing cron job.
  source    CouponSource @default(manual)
  /// Campaign tag for auto-generated coupons, e.g. `2026-10`. Unique, which is
  /// what makes the monthly job idempotent: a second run for the same month
  /// finds the existing row instead of minting another coupon.
  campaign  String?    @unique
  payment   Payment[]
  tarrif    Tarrif[]
}

/// How the discount is calculated. Unrelated to where the coupon came from.
enum CouponType {
  fixed
  percent
}

enum CouponSource {
  /// Created by hand in the admin panel.
  manual
  /// Minted by the monthly marketing cron job.
  autoGenerated
}

enum PaymentMethod {
  admin
  zarinPal
  no_method
}

enum PaymentStatus {
  failed
  success
  pending
  canceled
  could_not_initiate
}

//! PLAN --------------------------------
model Plan {
  id            Int               @id @default(autoincrement())
  key           PlanKey
  title         String
  level         Int
  startedAt     DateTime          @default(now())
  endsAt        DateTime
  isPremium     Boolean           @default(false)
  period        PlanPeriod
  type          PaymentPlanType
  fairDownload  Int
  downloaded    Int               @default(0)
  firstDownload DateTime?
  lastDownload  DateTime?
  status        PlanStatus        @default(active)
  histories     DownloadHistory[]

  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId Int?     @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}

enum PlanStatus {
  active
  inActive
}

enum PlanPeriod {
  monthly
  threeMonth
  annual
}

enum PlanKey {
  standard
  pro
  organization
}

enum PaymentPlanType {
  new
  renewal
}

//! NOTIFICATIONS --------------------------------
/// One row per notification actually attempted for a user.
///
/// The cron endpoints are stateless and may run more than once (a retry, an
/// overlapping schedule, a manual trigger), so "have we already told this user
/// about this?" cannot live in memory. `key` is the per-user dedupe key:
/// `welcome`, `subscription-expiring:<planId>`, `downloads-near-limit:<planId>`,
/// `payment-result:<paymentId>`, `marketing:<YYYY-MM>`. The unique
/// (userId, key, channel) index turns a re-run into a no-op instead of a second
/// email — and because the row is per channel, one warning can reach the user by
/// email even when the SMS leg failed or was skipped.
model NotificationLog {
  id        Int                 @id @default(autoincrement())
  key       String
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus
  /// Provider message id (Resend) or the failure reason, for support tickets.
  detail    String?
  createdAt DateTime            @default(now())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  @@unique([userId, key, channel])
  @@index([type, createdAt])
}

enum NotificationType {
  welcome
  subscriptionExpiring
  downloadsNearLimit
  paymentResult
  marketing
}

enum NotificationChannel {
  email
  sms
}

enum NotificationStatus {
  sent
  skipped
  failed
}

//! TARRIF --------------------------------

model Tarrif {
  id               Int                     @id @default(autoincrement())
  title            String
  key              PlanKey                 @unique
  description      String
  shortDescription String
  isRecommended    Boolean
  level            Int
  discountAmount   Float                   @default(0)
  fairDownload     FairDownload?
  price            Price?
  features         SelectedTarrifFeature[]
  coupon           Coupon[]
  payments         Payment[]
}

model TarrifFeature {
  id                     Int                     @id @default(autoincrement())
  title                  String
  type                   TarrifFeatureType
  selectedTarrifFeatures SelectedTarrifFeature[]
}

enum TarrifFeatureType {
  general
  paid
}

model SelectedTarrifFeature {
  id              Int           @id @default(autoincrement())
  tarrifFeature   TarrifFeature @relation(fields: [tarrifFeatureId], references: [id], onDelete: Cascade)
  tarrifFeatureId Int
  tarrif          Tarrif        @relation(fields: [tarrifId], references: [id], onDelete: Cascade)
  tarrifId        Int
}

model FairDownload {
  id         Int   @id @default(autoincrement())
  monthly    Float
  threeMonth Float
  annual     Float

  tarrif   Tarrif @relation(fields: [tarrifId], references: [id], onDelete: Cascade)
  tarrifId Int    @unique
}

model Price {
  id         Int   @id @default(autoincrement())
  monthly    Float
  threeMonth Float
  annual     Float

  tarrif   Tarrif @relation(fields: [tarrifId], references: [id], onDelete: Cascade)
  tarrifId Int    @unique
}

//! NOTIFICATION BAR --------------------------------

/// The announcement bar pinned to the top of every page in both apps.
///
/// Deliberately separate from `NotificationLog` (which records messages actually
/// sent to a user): this is a single editable row of site-wide copy. Both
/// deployments read the same database, so one edit in the admin panel shows up on
/// the client site too. A row with `active = false`, or one whose `expiresAt` has
/// passed, is not rendered at all.
model NotificationBar {
  id        Int      @id @default(autoincrement())
  text      String
  /// Optional call to action. Both fields must be set for the button to render.
  ctaTitle  String?
  ctaLink   String?
  /// Optional deadline: while it is in the future the bar shows a live countdown.
  expiresAt DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
