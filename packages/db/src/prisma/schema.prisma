generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

//! USERS --------------------------------
model Admin {
  id          Int    @id @default(autoincrement())
  fullName    String
  phoneNumber String @unique
  email       String @unique
  password    String
}

model User {
  id                  Int        @id @default(autoincrement())
  email               String     @unique
  phoneNumber         String     @unique
  firstName           String
  lastName            String?
  fullName            String
  usageGoal           UsageGoal?
  onboardingCompleted Boolean    @default(false)
  joinedAt            DateTime   @default(now())
  userType            UserType?

  downloads     DownloadHistory[]
  favedDielines FavedDieline[]
  savedDielines SavedDieline[]
  plans         Plan[]
  payments      Payment[]
  customers     Customer[]
  paymentTracks PaymentTrack[]
}

enum UsageGoal {
  practice
  projects
  portfolio
  hobby
  other
}

enum UserType {
  student
  designer
  designStudio
  printHouse
  dielineMaker
  packagingFactory
  other
}

model Customer {
  id          Int      @id @default(autoincrement())
  fullName    String
  phoneNumber String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())

  savedDielie SavedDieline[]
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int?
}

model Otp {
  id          Int      @id @default(autoincrement())
  phoneNumber String
  code        String
  expiresAt   DateTime

  @@unique([code, phoneNumber])
}

//! DIELINE --------------------------------
model Dieline {
  id              Int      @id @default(autoincrement())
  title           String
  slug            String   @unique
  specification   String   @db.MediumText
  variable        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  active          Boolean  @default(true)
  materials       String
  defaultMaterial String   @default("eFlute")
  dimensionTypes  String
  minWidth        Float
  minLength       Float
  minHeight       Float

  categoryByUsage DielineCategoryByUsage[]
  categoryByModel DielineCategoryByModel[]
  downloadHistory DownloadHistory[]
  favedDieline    FavedDieline[]
  savedDielines   SavedDieline[]
  settings        DielineSettings          @relation(fields: [settingsId], references: [id])
  settingsId      Int                      @unique
  dielineImage    DielineImage?
  modelImage      ModelImage?
}

model DielineImage {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String   @unique
  createdAt DateTime @default(now())
  dieline   Dieline  @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId Int      @unique
}

model ModelImage {
  id        Int      @id @default(autoincrement())
  url       String
  publicId  String   @unique
  createdAt DateTime @default(now())
  dieline   Dieline  @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId Int      @unique
}

model DielineSettings {
  id            Int           @id @default(autoincrement())
  bleed         Int
  thickness     Float
  material      String
  width         Float
  length        Float
  height        Float
  dimensionType DimensionType

  dieline Dieline?
}

model CustomDielineSettings {
  id            Int           @id @default(autoincrement())
  bleed         Int
  thickness     Float
  material      String
  width         Float
  length        Float
  height        Float
  dimensionType DimensionType

  savedDieline      SavedDieline?    @relation(fields: [savedDielineId], references: [id], onDelete: Cascade)
  savedDielineId    Int?             @unique
  downloadHistory   DownloadHistory? @relation(fields: [downloadHistoryId], references: [id], onDelete: SetNull)
  downloadHistoryId Int?             @unique
}

model DielineCategoryByUsage {
  id      Int       @id @default(autoincrement())
  title   String
  slug    String    @unique
  dieline Dieline[]
}

model DielineCategoryByModel {
  id      Int       @id @default(autoincrement())
  title   String
  slug    String    @unique
  dieline Dieline[]
}

model SavedDieline {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dieline    Dieline                @relation(fields: [dielineId], references: [id])
  dielineId  Int
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  customer   Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId Int?
  settings   CustomDielineSettings?
}

model DownloadHistory {
  id           Int      @id @default(autoincrement())
  downloadedAt DateTime @default(now())

  dieline   Dieline @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  plan      Plan    @relation(fields: [planId], references: [id])
  planId    Int

  settings CustomDielineSettings?
}

model FavedDieline {
  id Int @id @default(autoincrement())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  dieline   Dieline @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId Int

  @@unique([userId, dielineId])
}

enum Material {
  cFlute
  beFlute
  bcFlute
  abFlute
  artPaper
  glossyCardboard
  fFlute
  eFlute
  bFlute
}

enum DimensionType {
  manufacture
  inner
  outer
}

//! PAYMENT --------------------------------
model Payment {
  id                 Int           @id @default(autoincrement())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  amount             Float
  total              Float
  totalDiscount      Float
  discountCodeAmount Float
  discountCode       String?
  status             PaymentStatus
  method             PaymentMethod
  authority          String?       @unique
  period             PlanPeriod

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  tarrif   Tarrif  @relation(fields: [tarrifId], references: [id])
  tarrifId Int
  plan     Plan?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId Int?
}

model PaymentTrack {
  id     Int        @id @default(autoincrement())
  plan   PlanKey
  period PlanPeriod
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
}

model Coupon {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  expiresAt DateTime
  amount    Float
  used      Int        @default(0)
  limit     Int?
  createdAt DateTime   @default(now())
  type      CouponType
  payment   Payment[]
  tarrif    Tarrif[]
}

enum CouponType {
  fixed
  percent
}

enum PaymentMethod {
  admin
  zarinPal
  no_method
}

enum PaymentStatus {
  failed
  success
  pending
  canceled
  could_not_initiate
}

//! PLAN --------------------------------
model Plan {
  id            Int               @id @default(autoincrement())
  key           PlanKey
  title         String
  level         Int
  startedAt     DateTime          @default(now())
  endsAt        DateTime
  isPremium     Boolean           @default(false)
  period        PlanPeriod
  type          PaymentPlanType
  fairDownload  Int
  downloaded    Int               @default(0)
  firstDownload DateTime?
  lastDownload  DateTime?
  status        PlanStatus        @default(active)
  histories     DownloadHistory[]

  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId Int?     @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}

enum PlanStatus {
  active
  inActive
}

enum PlanPeriod {
  monthly
  threeMonth
  annual
}

enum PlanKey {
  standard
  pro
  organization
}

enum PaymentPlanType {
  new
  renewal
}

//! TARRIF --------------------------------

model Tarrif {
  id               Int                     @id @default(autoincrement())
  title            String
  key              PlanKey                 @unique
  description      String
  shortDescription String
  isRecommended    Boolean
  level            Int
  discountAmount   Float                   @default(0)
  fairDownload     FairDownload?
  price            Price?
  features         SelectedTarrifFeature[]
  coupon           Coupon[]
  payments         Payment[]
}

model TarrifFeature {
  id                     Int                     @id @default(autoincrement())
  title                  String
  type                   TarrifFeatureType
  selectedTarrifFeatures SelectedTarrifFeature[]
}

enum TarrifFeatureType {
  general
  paid
}

model SelectedTarrifFeature {
  id              Int           @id @default(autoincrement())
  tarrifFeature   TarrifFeature @relation(fields: [tarrifFeatureId], references: [id], onDelete: Cascade)
  tarrifFeatureId Int
  tarrif          Tarrif        @relation(fields: [tarrifId], references: [id], onDelete: Cascade)
  tarrifId        Int
}

model FairDownload {
  id         Int   @id @default(autoincrement())
  monthly    Float
  threeMonth Float
  annual     Float

  tarrif   Tarrif @relation(fields: [tarrifId], references: [id], onDelete: Cascade)
  tarrifId Int    @unique
}

model Price {
  id         Int   @id @default(autoincrement())
  monthly    Float
  threeMonth Float
  annual     Float

  tarrif   Tarrif @relation(fields: [tarrifId], references: [id], onDelete: Cascade)
  tarrifId Int    @unique
}
