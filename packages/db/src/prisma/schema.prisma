generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

//! USERS --------------------------------
model Admin {
  id          Int    @id @default(autoincrement())
  fullName    String
  phoneNumber String
  email       String
  password    String
}

model User {
  id                  Int      @id @default(autoincrement())
  email               String   @unique
  phoneNumber         String   @unique
  firstName           String
  lastName            String
  fullName            String
  onboardingCompleted Boolean  @default(false)
  joinedAt            DateTime @default(now())
  userType            UserType

  downloads     DownloadHistory[]
  otp           Otp[]
  favedDielines FavedDieline[]
  savedDielines SavedDieline[]
  plans         Plan[]
  payments      Payment[]
  customers     Customer[]
  paymentTracks PaymentTrack[]
}

enum UserType {
  student
  designer
  designStudio
  printHouse
  dielineMaker
  packagingFactory
  other
}

model Otp {
  id        Int      @id @default(autoincrement())
  otp       String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}

model Customer {
  id          Int      @id @default(autoincrement())
  fullName    String
  phoneNumber String?
  email       String?
  address     String?
  createdAt   DateTime @default(now())

  savedDielie SavedDieline[]
  user        User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int?
}

//! DIELINE --------------------------------
model Dieline {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  specification String   @db.MediumText
  variable      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  active        Boolean  @default(false)

  settings        DefaultSettings          @relation(fields: [settingsId], references: [id])
  settingsId      Int                      @unique
  categoryByUsage DielineCategoryByUsage[]
  categoryByModel DielineCategoryByModel[]
  downloadHistory DownloadHistory[]
  favedDieline    FavedDieline[]
  savedDielines   SavedDieline[]
}

model DefaultSettings {
  id                 Int              @id @default(autoincrement())
  bleed              Int
  materials          String
  dimensionTypes     String
  defaultDimension   DefaultDimension @relation(fields: [defaultDimensionId], references: [id])
  defaultDimensionId Int              @unique
  minDimension       MinDimension     @relation(fields: [minDimensionId], references: [id])
  minDimensionId     Int              @unique
  dieline            Dieline?
}

model DefaultDimension {
  id       Int              @id @default(autoincrement())
  width    Int
  length   Int
  height   Int
  settings DefaultSettings?
}

model MinDimension {
  id       Int              @id @default(autoincrement())
  width    Int
  length   Int
  height   Int
  settings DefaultSettings?
}

model DielineCategoryByUsage {
  id      Int       @id @default(autoincrement())
  title   String
  slug    String    @unique
  dieline Dieline[]
}

model DielineCategoryByModel {
  id      Int       @id @default(autoincrement())
  title   String
  slug    String    @unique
  dieline Dieline[]
}

model SavedDieline {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings   Settings?
  dieline    Dieline   @relation(fields: [dielineId], references: [id])
  dielineId  Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId Int?
}

model DownloadHistory {
  id           Int      @id @default(autoincrement())
  downloadedAt DateTime @default(now())

  dieline   Dieline @relation(fields: [dielineId], references: [id])
  dielineId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  settings Settings?
  plan     Plan      @relation(fields: [planId], references: [id])
  planId   Int
}

model FavedDieline {
  id Int @id @default(autoincrement())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  dieline   Dieline @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId Int

  @@unique([userId, dielineId])
}

model Settings {
  id            Int           @id @default(autoincrement())
  bleed         Int
  width         Float
  height        Float
  length        Float
  thickness     Float
  material      Material
  dimensionType DimensionType

  downloadHistory   DownloadHistory? @relation(fields: [downloadHistoryId], references: [id])
  downloadHistoryId Int?             @unique
  savedDielines     SavedDieline?    @relation(fields: [savedDielinesId], references: [id])
  savedDielinesId   Int?             @unique
}

enum Material {
  cFlute
  beFlute
  bcFlute
  abFlute
  artPaper
  glossyCardboard
  fFlute
  eFlute
  bFlute
}

enum DimensionType {
  manufacture
  inner
  outer
}

//! PAYMENT --------------------------------
model Payment {
  id                 Int           @id @default(autoincrement())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  amount             Float
  total              Float
  totalDiscount      Float
  discountCodeAmount Float
  discountCode       String?
  status             PaymentStatus
  method             PaymentMethod
  authority          String?       @unique
  period             PlanPeriod

  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  tarrif   Tarrif  @relation(fields: [tarrifId], references: [id])
  tarrifId Int
  plan     Plan?   @relation(fields: [planId], references: [id], onDelete: Restrict)
  planId   Int?    @unique
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId Int?
}

model PaymentTrack {
  id     Int        @id @default(autoincrement())
  plan   PlanKey
  period PlanPeriod
  user   User       @relation(fields: [userId], references: [id])
  userId Int
}

model Coupon {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  expiresAt DateTime
  amount    Float
  used      Int        @default(0)
  limit     Int?
  createdAt DateTime   @default(now())
  type      CouponType
  payment   Payment[]
  tarrif    Tarrif[]
}

enum CouponType {
  fixed
  percent
}

enum PaymentMethod {
  admin
  zarinPal
  no_method
}

enum PaymentStatus {
  failed
  success
  pending
  canceled
  could_not_initiate
}

//! PLAN --------------------------------
model Plan {
  id            Int               @id @default(autoincrement())
  key           PlanKey
  title         String
  level         Int
  startedAt     DateTime          @default(now())
  endsAt        DateTime
  isPremium     Boolean           @default(false)
  period        PlanPeriod
  type          PaymentPlanType
  fairDownload  Int
  downloaded    Int               @default(0)
  firstDownload DateTime?
  lastDownload  DateTime?
  status        PlanStatus        @default(active)
  histories     DownloadHistory[]

  payment Payment?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int
}

enum PlanStatus {
  active
  inActive
}

enum PlanPeriod {
  monthly
  threeMonth
  annual
}

enum PlanKey {
  standard
  pro
  organization
}

enum PaymentPlanType {
  new
  renewal
}

//! TARRIF --------------------------------

model Tarrif {
  id               Int                     @id @default(autoincrement())
  title            String
  key              PlanKey                 @unique
  description      String
  shortDescription String
  isRecommended    Boolean
  level            Int
  discountAmount   Float                   @default(0)
  fairDownload     FairDownload?
  price            Price?
  features         SelectedTarrifFeature[]
  coupon           Coupon[]
  payments         Payment[]
}

model TarrifFeature {
  id                     Int                     @id @default(autoincrement())
  title                  String
  type                   TarrifFeatureType
  selectedTarrifFeatures SelectedTarrifFeature[]
}

enum TarrifFeatureType {
  general
  paid
}

model SelectedTarrifFeature {
  id              Int           @id @default(autoincrement())
  tarrifFeature   TarrifFeature @relation(fields: [tarrifFeatureId], references: [id], onDelete: Cascade)
  tarrifFeatureId Int
  tarrif          Tarrif        @relation(fields: [tarrifId], references: [id], onDelete: Cascade)
  tarrifId        Int
}

model FairDownload {
  id         Int   @id @default(autoincrement())
  monthly    Float
  threeMonth Float
  annual     Float

  tarrif   Tarrif @relation(fields: [tarrifId], references: [id], onDelete: Cascade)
  tarrifId Int    @unique
}

model Price {
  id         Int   @id @default(autoincrement())
  monthly    Float
  threeMonth Float
  annual     Float

  tarrif   Tarrif @relation(fields: [tarrifId], references: [id], onDelete: Cascade)
  tarrifId Int    @unique
}
