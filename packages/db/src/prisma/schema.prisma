generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

//! USERS --------------------------------
model Admin {
  id          Int    @id @default(autoincrement())
  fullName    String
  phoneNumber String
  email       String
  password    String
}

model User {
  id                  Int      @id @default(autoincrement())
  email               String   @unique
  phoneNumber         String   @unique
  fullName            String
  onboardingCompleted Boolean  @default(false)
  joinedAt            DateTime @default(now())
  userType            UserType

  downloads     DownloadHistory[]
  otp           Otp[]
  favedDielines FavedDieline[]
  savedDielines SavedDieline[]
  paymentPlans  Plan[]
}

enum UserType {
  student
  designer
  designStudio
  printHouse
  dielineMaker
  packagingFactory
  other
}

model Otp {
  id        Int      @id @default(autoincrement())
  otp       String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}

model Customer {
  id          Int     @id @default(autoincrement())
  fullName    String
  phoneNumber String?
  email       String?
  address     String?

  savedDielie SavedDieline[]
}

//! DIELINE --------------------------------
model Dieline {
  id            Int      @id @default(autoincrement())
  title         String
  slug          String   @unique
  specification String   @db.MediumText
  variable      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  active        Boolean  @default(false)

  settings        DefaultSettings          @relation(fields: [settingsId], references: [id])
  settingsId      Int                      @unique
  categoryByUsage DielineCategoryByUsage[]
  categoryByModel DielineCategoryByModel[]
  downloadHistory DownloadHistory[]
  favedDieline    FavedDieline[]
  savedDielines   SavedDieline[]
}

model DefaultSettings {
  id                 Int              @id @default(autoincrement())
  bleed              Int
  materials          String
  dimensionTypes     String
  defaultDimension   DefaultDimension @relation(fields: [defaultDimensionId], references: [id])
  defaultDimensionId Int              @unique
  minDimension       MinDimension     @relation(fields: [minDimensionId], references: [id])
  minDimensionId     Int              @unique
  dieline            Dieline?
}

model DefaultDimension {
  id       Int              @id @default(autoincrement())
  width    Int
  length   Int
  height   Int
  settings DefaultSettings?
}

model MinDimension {
  id       Int              @id @default(autoincrement())
  width    Int
  length   Int
  height   Int
  settings DefaultSettings?
}

model DielineCategoryByUsage {
  id      Int       @id @default(autoincrement())
  title   String
  slug    String    @unique
  dieline Dieline[]
}

model DielineCategoryByModel {
  id      Int       @id @default(autoincrement())
  title   String
  slug    String    @unique
  dieline Dieline[]
}

model SavedDieline {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  settings   Settings?
  dieline    Dieline   @relation(fields: [dielineId], references: [id])
  dielineId  Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId Int?
}

model DownloadHistory {
  id           Int      @id @default(autoincrement())
  downloadedAt DateTime @default(now())

  dieline   Dieline @relation(fields: [dielineId], references: [id])
  dielineId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  settings Settings?
}

model FavedDieline {
  id Int @id @default(autoincrement())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  dieline   Dieline @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId Int

  @@unique([userId, dielineId])
}

model Settings {
  id            Int           @id @default(autoincrement())
  bleed         Int
  width         Float
  height        Float
  length        Float
  thickness     Float
  material      Material
  dimensionType DimensionType

  downloadHistory   DownloadHistory? @relation(fields: [downloadHistoryId], references: [id])
  downloadHistoryId Int?             @unique
  savedDielines     SavedDieline?    @relation(fields: [savedDielinesId], references: [id])
  savedDielinesId   Int?             @unique
}

enum Material {
  cFlute
  beFlute
  bcFlute
  abFlute
  artPaper
  glossyCardboard
  fFlute
  eFlute
  bFlute
}

enum DimensionType {
  manufacture
  inner
  outer
}

//! PAYMENT --------------------------------
model Payment {
  id                 Int           @id @default(autoincrement())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  amount             Float
  total              Float
  totalDiscount      Float
  discountCodeAmount Float
  discountCode       String
  status             PaymentStatus

  plan          Plan @relation(fields: [paymentPlanId], references: [id], onDelete: Restrict)
  paymentPlanId Int  @unique
}

enum PaymentStatus {
  failed
  success
  pending
  canceled
}

model Plan {
  id        Int             @id @default(autoincrement())
  key       PlanKey
  title     String
  level     Int
  startedAt DateTime        @default(now())
  endsAt    DateTime
  period    PlanPeriod
  type      PaymentPlanType

  downloads UserDownload[]
  payments  Payment?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}

model Tarrif {
  id               Int     @id @default(autoincrement())
  key              PlanKey
  title            String
  shortDescription String
  description      String
  fairDownload     Int
  monthly          Float
  threeMonth       Float
  annual           Float
}

model UserDownload {
  id            Int      @id @default(autoincrement())
  fair          Int
  downloaded    Int
  firstDownload DateTime
  lastDownload  DateTime

  plan   Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId Int?
}

enum PlanPeriod {
  monthly
  threeMonth
  annual
}

enum PaymentPlanType {
  new
  renewal
}

enum PlanKey {
  standard
  pro
  organization
}
