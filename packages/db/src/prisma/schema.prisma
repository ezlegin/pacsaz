generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

//! USERS --------------------------------
model Admin {
  id          Int    @id @default(autoincrement())
  fullName    String
  phoneNumber String
  email       String
  password    String
}

model User {
  id                  Int      @id @default(autoincrement())
  email               String   @unique
  phoneNumber         String   @unique
  fullName            String
  onboardingCompleted Boolean
  joinedAt            DateTime @default(now())
  type                UserType

  downloads     DownloadRecord[]
  otp           Otp[]
  favedDielines FavedDieline[]
  savedDielines SavedDieline[]
  paymentPlans  PaymentPlan[]
}

enum UserType {
  student
  designer
  designStudio
  printHouse
  dielineMaker
  packagingFactory
  other
}

model Otp {
  id        Int      @id @default(autoincrement())
  otp       String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
}

model Customer {
  id            Int            @id @default(autoincrement())
  fullName      String
  phoneNumber   String?
  email         String?
  address       String?
  savedDielines SavedDieline[]
}

//! PLAN --------------------------------
model Plan {
  id    Int     @id @default(autoincrement())
  key   PlanKey
  title String
  level Int

  paymentPlans PaymentPlan[]
}

//! Download --------------------------------
model Download {
  id            Int      @id @default(autoincrement())
  fair          Int
  downloaded    Int
  firstDownload DateTime
  lastDownload  DateTime

  paymentPlan PaymentPlan[]
}

model DownloadRecord {
  id        Int               @id @default(autoincrement())
  date      DateTime
  dimension DielineDimension?
  material  Material
  thickness Int
  bleed     Int

  dieline   Dieline @relation(fields: [dielineId], references: [id])
  dielineId Int
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
}

enum Material {
  bFlute
  eFlute
  fFlute
  cFlute
  beFlute
  bcFlute
  abFlute
  glossyCardboard
  artPaper
}

model DielineDimension {
  id     Int @id @default(autoincrement())
  width  Int
  length Int
  height Int

  downloadRecord   DownloadRecord @relation(fields: [downloadRecordId], references: [id])
  downloadRecordId Int            @unique
  dielineInfos     DielineInfo[]
}

//! DIELINE --------------------------------
model Dieline {
  id       Int               @id @default(autoincrement())
  slug     String
  title    String
  image    DielineImage?
  category DielineCategory[]

  downloadRecords DownloadRecord[]
  favedDieline    FavedDieline[]
  dielineInfos    DielineInfo[]
}

model DielineCategory {
  id      Int          @id @default(autoincrement())
  title   String
  slug    String
  type    CategoryType
  dieline Dieline[]
}

enum CategoryType {
  byUsage
  byModel
}

model DielineImage {
  id       Int     @id @default(autoincrement())
  modelImg String?
  trimImg  String?

  dieline   Dieline @relation(fields: [dielineId], references: [id])
  dielineId Int     @unique
}

model FavedDieline {
  id Int @id @default(autoincrement())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  dieline   Dieline @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId Int
}

model DielineInfo {
  id            Int           @id @default(autoincrement())
  material      Material
  thickness     Int
  thicknessType ThicknessType
  bleed         Int
  dimensionType DimensionType

  dieline            Dieline          @relation(fields: [dielineId], references: [id], onDelete: Cascade)
  dielineId          Int
  dimension          DielineDimension @relation(fields: [dielineDimensionId], references: [id])
  dielineDimensionId Int
}

enum DimensionType {
  manufacture
  inner
  outer
}

enum ThicknessType {
  custom
  material
}

model SavedDieline {
  id               Int      @id @default(autoincrement())
  title            String
  shortDescription String
  createdAt        DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
}

//! PAYMENT --------------------------------
model Payment {
  id             Int             @id @default(autoincrement())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  amount         Int
  totalDiscount  Int
  discountAmount Int
  discountCode   String
  total          Int
  type           PaymentPlanType
  status         PaymentStatus

  plan          PaymentPlan @relation(fields: [paymentPlanId], references: [id])
  paymentPlanId Int         @unique
}

enum PaymentStatus {
  failed
  success
  pending
  canceled
}

model PaymentPlan {
  id        Int             @id @default(autoincrement())
  key       PlanKey
  title     String
  level     Int
  startedAt DateTime        @default(now())
  endsAt    DateTime
  period    PlanPeriod
  type      PaymentPlanType

  downloads Download[]
  payments  Payment?
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  plan      Plan       @relation(fields: [planId], references: [id])
  planId    Int
}

enum PlanPeriod {
  monthly
  threeMonth
  annual
}

enum PaymentPlanType {
  renewal
  new
}

enum PlanKey {
  standard
  pro
  orgnization
}
